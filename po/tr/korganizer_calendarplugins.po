msgid "MMMM_d"
msgstr "MMMM_d"

#: thisdayinhistory/thisdayinhistory.cpp:51
#, kde-format
msgid "This month in history"
msgstr "Tarihte bu ay"

#: thisdayinhistory/thisdayinhistory.cpp:54
