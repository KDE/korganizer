#, kde-format
msgctxt "weekOfYear (year)"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: datenums/datenums.cpp:107
#, kde-format
msgctxt "Week weekOfYear (year)"
msgid "Week %1 (%2)"
msgstr "%1. Hafta (%2)"

#: datenums/datenums.cpp:122
#, kde-format
msgid "1 week remaining"
msgid_plural "%1 weeks remaining"
msgstr[0] "1 hafta kaldı"
