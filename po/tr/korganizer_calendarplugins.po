#: datenums/configdialog.cpp:28
#, kde-format
msgctxt "@title:window"
msgid "Configure Day Numbers"
msgstr "Gün Numaralarını Yapılandır"

#: datenums/configdialog.cpp:43
#, kde-format
msgctxt "@title:group"
msgid "Show Date Number"
msgstr "Tarih Numarasını Göster"

#: datenums/configdialog.cpp:48
#, kde-format
msgctxt "@option:radio"
msgid "Show day number"
msgstr "Gün numarasını göster"

#: datenums/configdialog.cpp:49
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the year's day number"
msgstr "Yılın gününün numarasını göster"

#: datenums/configdialog.cpp:50
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to show the day number of the current year."
msgstr "Şu anki yılın gün numarasını göstermek için bu seçeneği işaretleyin."

#: datenums/configdialog.cpp:53
#, kde-format
msgctxt "@option:radio"
msgid "Show days to end of year"
msgstr "Yılın sonuna kadar günleri göster"

#: datenums/configdialog.cpp:54
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the number of days remaining in the year"
msgstr "Yılda kalan günlerin sayısını göster"

#: datenums/configdialog.cpp:55
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show the number of days remaining in the current year."
msgstr ""
"Şu anki yılda kalan günlerin sayısını göstermek için bu seçeneği işaretleyin."

#: datenums/configdialog.cpp:58
#, kde-format
msgctxt "@option:radio"
msgid "Show both"
msgstr "Her ikisini de göster"

#: datenums/configdialog.cpp:59
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Show both the year's day number and the number of days remaining in the year"
msgstr "Hem yılın gün numarasını hem de kalan gün sayısını göster"

#: datenums/configdialog.cpp:61
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show both the year's day number and the number of days "
"remaining in the current year. The format is dayOfYear / daysTillEndOfYear"
msgstr ""
"Hem geçerli yılın gün numarasını hem de yılda kalan gün sayısını göstermek "
"için bu seçeneği işaretleyin. Biçim, yılın_günü / kalan_gün_sayısı "
"şeklindedir."

#: datenums/datenums.cpp:36
#, kde-format
msgid "This plugin shows information on a day's position in the year."
msgstr "Bu eklenti yıl içerisindeki bir gün hakkındaki bilgiler gösterir."

#: datenums/datenums.cpp:54
#, kde-format
msgid "1 day before the end of the year"
msgid_plural "%1 days before the end of the year"
msgstr[0] "Yılın bitişine 1 gün var"
msgstr[1] "Yılın bitişine %1 gün var"

#: datenums/datenums.cpp:59
#, kde-format
msgctxt "dayOfYear / daysTillEndOfYear"
msgid "%1 / %2"
msgstr "%1/%2"

#: datenums/datenums.cpp:60
#, kde-format
msgid "1 day since the beginning of the year,\n"
msgid_plural "%1 days since the beginning of the year,\n"
msgstr[0] "Yılın başlangıcından beri 1 gün geçti,\n"
msgstr[1] "Yılın başlangıcından beri %1 gün geçti,\n"

#: datenums/datenums.cpp:61
#, kde-format
msgid "1 day until the end of the year"
msgid_plural "%1 days until the end of the year"
msgstr[0] "Yılın bitişine dek 1 gün var"
msgstr[1] "Yılın bitişine dek %1 gün var"

