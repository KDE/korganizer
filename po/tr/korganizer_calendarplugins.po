#: datenums/datenums.cpp:123
#, kde-format
msgid "1 week until the end of the year"
msgid_plural "%1 weeks until the end of the year"
msgstr[0] "Yılın bitmesine 1 hafta kaldı"
msgstr[1] "Yılın bitmesine %1 hafta kaldı"

